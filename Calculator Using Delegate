using System;

class Program
{
    public delegate double Calculator(double a, double b);

    static double Add(double a, double b)
    {
        return a + b;
    }

    static double Subtract(double a, double b)
    {
        return a - b;
    }

    static double Multiply(double a, double b)
    {
        return a * b;
    }

    static double Divide(double a, double b)
    {
        return a / b;
    }

    static void Main()
    {
        Calculator cal;

        cal = Add;
        Console.WriteLine("Addition = " + cal(20, 10));

        cal = Subtract;
        Console.WriteLine("Subtraction = " + cal(20, 10));

        cal = Multiply;
        Console.WriteLine("Multiplication = " + cal(20, 10));

        cal = Divide;
        Console.WriteLine("Division = " + cal(20, 10));
    }
}
 
 
